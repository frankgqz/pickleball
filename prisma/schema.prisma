// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url is now in prisma.config.ts
}

// ============================================
// PLAYER — Global player database (shared lookup)
// ============================================
model Player {
  id              String        @id @default(cuid())
  name            String
  duprId          String?
  duprNumericId   String?
  duprScore       Float?
  manualDuprScore Float?
  imageUrl        String?
  lastRefreshed   DateTime?
  
  clubPlayers     ClubPlayer[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([name])
  @@index([duprId])
  @@index([duprNumericId])
}

// ============================================
// USER — Club/organization (NextAuth)
// ============================================
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  image        String?
  
  clubPlayers  ClubPlayer[]
  events       Event[]
  
  createdAt    DateTime      @default(now())
}

// ============================================
// CLUBPLAYER — Player in a club's roster
// ============================================
model ClubPlayer {
  id            String   @id @default(cuid())
  
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id])
  playerName    String   @default("")
  
  eventCount    Int      @default(0)
  lastAttended  DateTime?
  note          String?
  
  eventPlayers  EventPlayer[]
  
  createdAt     DateTime @default(now())

  @@unique([userId, playerId])
  @@index([playerName])
  @@index([userId])
  @@index([playerId])
}

// ============================================
// EVENT — An event/tournament
// ============================================
model Event {
  id            String        @id @default(cuid())
  name          String
  format        String        @default("STANDARD")
  pointsPerGame Int           @default(11)
  winByTwo      Boolean       @default(true)
  courtCount    Int           @default(5)
  orderDelta    Int           @default(2)
  status        String        @default("SETUP")
  
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  
  eventPlayers  EventPlayer[]
  rounds        EventRound[]
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ============================================
// EVENTPLAYER — Player in an event
// ============================================
model EventPlayer {
  id          String     @id @default(cuid())
  
  eventId     String
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  clubPlayerId String
  clubPlayer   ClubPlayer @relation(fields: [clubPlayerId], references: [id], onDelete: Cascade)
  
  isSitting   Boolean    @default(false)
  orderScore  Float      @default(0)
  seed        Int        @default(999)
  
  createdAt   DateTime   @default(now())

  @@unique([eventId, clubPlayerId])
  @@index([clubPlayerId])
  @@index([eventId])
}

// ============================================
// EVENTROUND — Round in an event
// ============================================
model EventRound {
  id          String   @id @default(cuid())
  
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  roundNumber Int
  matches     Json
  sittingOut  Json?
  format      String?
  date        DateTime @default(now())

  @@index([eventId])
  @@index([eventId, roundNumber])
}