// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url is now in prisma.config.ts
}

// ============================================
// PLAYER — Global player database (shared lookup)
// ============================================
model Player {
  id              String        @id @default(cuid())
  name            String
  duprId          String?
  duprNumericId   String?
  duprScore       Float?
  manualDuprScore Float?
  imageUrl        String?
  lastRefreshed   DateTime?
  
  clubPlayers     ClubPlayer[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([name])
  @@index([duprId])
  @@index([duprNumericId])
}

// ============================================
// USER — Club/organization (NextAuth)
// ============================================
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  image        String?
  
  clubPlayers  ClubPlayer[]
  sessions     Session[]

  createdAt    DateTime      @default(now())
}

// ============================================
// CLUBPLAYER — Player in a club's roster
// ============================================
model ClubPlayer {
  id            String   @id @default(cuid())
  
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id])
  playerName    String   @default("")
  
  eventCount    Int      @default(0)
  lastAttended  DateTime?
  note          String?
   
  createdAt     DateTime @default(now())

  @@unique([userId, playerId])
  @@index([playerName])
  @@index([userId])
  @@index([playerId])
}

// ============================================
// SESSION — The Session's details
// ============================================
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  isEnded   Boolean  @default(false)
  config    Json     // matchType, scoreType, bestOf, format, etc.
  playerIds Json     // [playerId, ...]

  rounds    SessionRound[]

  @@index([userId])
}

// ============================================
// SESSIONROUND — Rounds in a session
// ============================================
model SessionRound {
  id          String  @id @default(cuid())
  sessionId   String
  session     Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  roundNumber Int
  date        String
  format      Json
  matches     Json
  sittingOut  Json?

  @@unique([sessionId, roundNumber])
  @@index([sessionId])
}
